{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080",
  "Runner": {
    "ExePath": "Binaries\\bedrock_server.exe",
    "LogFilePath": "logs\\runner.log"
  },
  "Backup": {
    "FrequencyMinutes": 30,
    "BackupDirectory": "backups",
    "MaxBackupsToKeep": 30
  }
}
