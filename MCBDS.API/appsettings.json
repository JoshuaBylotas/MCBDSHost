{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runner": {
    "ExePath": "/app/Binaries/bedrock_server",
    "LogFilePath": "/app/logs/runner.log"
  },
  "Backup": {
    "FrequencyMinutes": 20,
    "BackupDirectory": "/app/backups",
    "MaxBackupsToKeep": 60
  },
  "XboxLive": {
    "ApiKey": "",
    "ApiBaseUrl": "https://xbl.io/api/v2",
    "EnableCaching": true,
    "CacheExpirationMinutes": 1440
  }
}