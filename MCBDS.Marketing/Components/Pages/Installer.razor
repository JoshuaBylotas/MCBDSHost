</section>

<!-- What's New in v1.1 -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="alert alert-primary border-primary" role="alert">
                    <h4 class="alert-heading">
                        <i class="bi bi-star-fill me-2"></i>What's New in v1.1
                    </h4>
                    <hr>
                    <div class="row">
                        <div class="col-md-6">
                            <h5><i class="bi bi-box-seam text-primary me-2"></i>Pack Management</h5>
                            <ul>
                                <li>Upload resource packs (.zip or .mcpack)</li>
                                <li>Upload behavior packs (.zip or .mcpack)</li>
                                <li>Enable/disable packs with one click</li>
                                <li>Automatic manifest parsing</li>
                                <li>Pack validation and installation</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5><i class="bi bi-shield-check text-primary me-2"></i>Player Allowlist</h5>
                            <ul>
                                <li>Manage allowed players (whitelist)</li>
                                <li>Xbox Live XUID lookup integration</li>
                                <li>Manual XUID entry option</li>
                                <li>Player limit exceptions for VIPs</li>
                                <li>Automatic allowlist.json sync</li>
                            </ul>
                        </div>
                    </div>
                    <hr>
                    <p class="mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Backward Compatible:</strong> Old UI clients (v1.0) will work with v1.1 servers, but new features won't be available. 
                        New UI clients (v1.1) will work with old servers (v1.0), but pack management and allowlist features will be disabled gracefully.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Installation Steps -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <h2 class="text-center mb-5">
                    <i class="bi bi-gear me-2"></i>Installation Guide
                </h2>

                <!-- Step 1 -->
                <div class="installation-step mb-4">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3>Download Minecraft Bedrock Server</h3>
                        <p>Get the official Minecraft Bedrock Dedicated Server from Microsoft:</p>
                        <a href="https://www.minecraft.net/en-us/download/server/bedrock" 
                           target="_blank" 
                           rel="noopener" 
                           class="btn btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Download Bedrock Server
                        </a>
                        <p class="text-muted mt-3">
                            <small>Extract all files to a folder (e.g., <code>C:\Binaries\bedrock_server</code>). 
                            The <code>bedrock_server.exe</code> must be directly in this folder.</small>
                        </p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="installation-step mb-4">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3>Download MCBDS Installer</h3>
                        <p>Download the Windows Service installer:</p>
                        <a href="https://github.com/JoshuaBylotas/MCBDSHost/releases/download/API-v1.1/MCBDS.API.Service.Installer.exe" 
                           class="btn btn-primary">
                            <i class="bi bi-download me-2"></i>MCBDS.API.Service.Installer.exe
                        </a>
                        <p class="text-muted mt-3">
                            <small><i class="bi bi-shield-check me-1"></i>Digital signature verified • Safe to run</small>
                        </p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="installation-step mb-4">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3>Run Installer as Administrator</h3>
                        <p>Right-click the installer and select <strong>"Run as Administrator"</strong></p>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Administrator privileges are required to install the Windows Service and configure the firewall.
                        </div>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="installation-step mb-4">
                    <div class="step-number">4</div>
                    <div class="step-content">
                        <h3>Configure Installation</h3>
                        <p>The installer will guide you through configuration:</p>
                        <ul>
                            <li><strong>Bedrock Server Location:</strong> Point to where you extracted bedrock_server.exe</li>
                            <li><strong>HTTP Port:</strong> Default 8080 (for API access)</li>
                            <li><strong>Backup Settings:</strong> Frequency and retention</li>
                            <li><strong>Log Directory:</strong> Where to store logs</li>
                        </ul>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Upgrading from v1.0?</strong> Your existing settings will be preserved automatically!
                            The installer creates backups and merges configurations.
                        </div>
                    </div>
                </div>

                <!-- Step 5 -->
                <div class="installation-step mb-4">
                    <div class="step-number">5</div>
                    <div class="step-content">
                        <h3>Access the Dashboard</h3>
                        <p>Once installed, the service starts automatically. Access the web dashboard:</p>
                        <a href="http://localhost:8080" target="_blank" class="btn btn-success">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Open Dashboard
                        </a>
                        <p class="text-muted mt-3">
                            <small>Default URL: <code>http://localhost:8080</code> (or your configured port)</small>
                        </p>
                    </div>
                </div>

                <!-- Step 6 -->
                <div class="installation-step mb-4">
                    <div class="step-number">6</div>
                    <div class="step-content">
                        <h3>Configure Xbox Live API (Optional)</h3>
                        <p>For player allowlist with automatic XUID lookup, configure Xbox Live API:</p>
                        <ol>
                            <li>Get a free API key from <a href="https://xbl.io" target="_blank" rel="noopener">OpenXBL (xbl.io)</a></li>
                            <li>Edit <code>C:\Program Files\MCBDS API Service\appsettings.json</code></li>
                            <li>Add your API key to the <code>XboxLive</code> section</li>
                            <li>Restart the service: <code>net stop MCBDSAPIService && net start MCBDSAPIService</code></li>
                        </ol>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            Without an API key, you can still add players manually by entering their XUID.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

