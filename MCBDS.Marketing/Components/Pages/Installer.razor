@page "/installer"
@inject NavigationManager Navigation

<PageTitle>Download MCBDS Manager v1.1 - Windows Service Installer</PageTitle>

<HeadContent>
    <meta name="description" content="Download MCBDS Manager v1.1 Windows Service Installer. Easy setup with pack management, player allowlist, and automated backups for your Minecraft Bedrock server." />
</HeadContent>

<!-- Hero Section -->
<section class="installer-hero py-5 bg-gradient">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 mx-auto text-center">
                <span class="badge bg-primary mb-3">Latest Release v1.1</span>
                <h1 class="display-4 fw-bold text-white mb-4">
                    Download MCBDS Manager
                </h1>
                <p class="lead text-white mb-4">
                    Professional Windows Service installer with pack management, player allowlist, and automated backups.
                </p>
                <a href="https://github.com/JoshuaBylotas/MCBDSHost/releases/download/API-v1.1/MCBDS.API.Service.Installer.exe" 
                   class="btn btn-light btn-lg">
                    <i class="bi bi-download me-2"></i>Download Installer (v1.1)
