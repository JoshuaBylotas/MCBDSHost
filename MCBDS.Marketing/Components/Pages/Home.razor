@page "/"
@attribute [StreamRendering]
@inject StructuredDataService StructuredDataService

<PageTitle>MCBDS Manager - Professional Minecraft Bedrock Server Management</PageTitle>

<HeadContent>
    <meta name="description" content="Professional web-based management for Minecraft Bedrock Dedicated Server. Monitor, control, and automate your server with real-time monitoring, automated backups, and smart command console." />
    <meta name="keywords" content="minecraft bedrock server, minecraft server management, mcbds, bedrock dedicated server, server monitoring, windows service, pack management, minecraft automation" />
    <link rel="canonical" href="https://www.mc-bds.com/" />
    
    <!-- Structured Data for Organization -->
    <script type="application/ld+json">
        @((MarkupString)StructuredDataService.GetOrganizationData())
    </script>
    
    <!-- Structured Data for Software Application -->
    <script type="application/ld+json">
        @((MarkupString)StructuredDataService.GetSoftwareApplicationData())
    </script>
</HeadContent>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <!-- New Release Announcement -->
                <div class="alert alert-primary alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i>
                    <strong>🎉 NEW: API v1.1 Released!</strong> 
                    <a href="https://github.com/JoshuaBylotas/MCBDSHost/releases/tag/API-v1.1" target="_blank" rel="noopener" class="alert-link">
                        Pack Management & Player Allowlist
                    </a>
                    – Upload resource/behavior packs and manage player access
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <!-- Docker Deprecation Notice -->
                <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Important:</strong> Docker version will be deprecated in v1.2. 
                    <a href="/installer" class="alert-link">Migrate to Windows Service Installer</a> 
                    for better performance and automatic updates.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <h1 class="display-3 fw-bold mb-4">
                    Manage Your Minecraft Bedrock Server
                    <span class="text-primary">Like a Pro</span>
                </h1>
                <p class="lead mb-4">
                    Professional web-based management for Minecraft Bedrock Dedicated Server.
                    Monitor, control, and automate your server with an intuitive interface.
                </p>
                <div class="hero-buttons">
                    <a href="/installer" class="btn btn-primary btn-lg me-3">
                        <i class="bi bi-download me-2"></i>Download v1.1 Installer
                    </a>
                    <a href="/features" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-rocket-takeoff me-2"></i>Explore Features
                    </a>
                </div>
                <p class="text-muted mt-3">
                    <small>
                        <i class="bi bi-shield-check me-1"></i>
                        Fully backward compatible • Old UI works with v1.1 servers
                    </small>
                </p>
            </div>
            <div class="col-lg-6">
                <div class="dashboard-preview">
                    <picture>
                        <!-- Mobile: 600x300 -->
                        <source media="(max-width: 767px)" 
                                srcset="images/dashboard-preview-600.webp" 
                                type="image/webp">
                        
                        <!-- Tablet: 800x400 -->
                        <source media="(max-width: 1199px)" 
                                srcset="images/dashboard-preview-800.webp" 
                                type="image/webp">
                        
                        <!-- Desktop: 1200x600 -->
                        <source srcset="images/dashboard-preview-1200.webp" 
                                type="image/webp">
                        
                        <!-- Fallback PNG for older browsers -->
                        <img src="images/dashboard-preview-opt.png"
                             alt="MCBDS Manager Dashboard - Server Overview with real-time statistics"
                             class="img-fluid rounded shadow-lg"
                             width="1200"
                             height="600"
                             fetchpriority="high"
                             style="border: 4px solid rgba(0,0,0,0.2);" />
                    </picture>
                    <div class="dashboard-badge">
                        <i class="bi bi-eye-fill me-2"></i>Live Dashboard Preview
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Key Features Section -->
<section class="features-overview py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Everything You Need</h2>
            <p class="lead text-muted">Powerful features to manage your Minecraft server effortlessly</p>
        </div>

        <div class="row g-4">
            <!-- Feature 1 - NEW v1.1 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border-primary">
                    <div class="feature-icon bg-primary bg-gradient">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <span class="badge bg-primary mb-2">NEW v1.1</span>
                    <h3 class="h4 mb-3">Pack Management</h3>
                    <p class="text-muted">
                        Upload and manage resource packs and behavior packs directly from the web interface.
                        Enable/disable packs for your world with one click.
                    </p>
                </div>
            </div>

            <!-- Feature 2 - NEW v1.1 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4 border-primary">
                    <div class="feature-icon bg-primary bg-gradient">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <span class="badge bg-primary mb-2">NEW v1.1</span>
                    <h3 class="h4 mb-3">Player Allowlist</h3>
                    <p class="text-muted">
                        Control server access with allowlist management. Add/remove players with Xbox Live XUID lookup.
                        Set player limit exceptions for VIPs.
                    </p>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-success bg-gradient">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <h3 class="h4 mb-3">Real-Time Monitoring</h3>
                    <p class="text-muted">
                        Live server statistics including CPU usage, memory consumption, uptime, and player count.
                        Stay informed with auto-refreshing dashboards.
                    </p>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-success bg-gradient">
                        <i class="bi bi-terminal"></i>
                    </div>
                    <h3 class="h4 mb-3">Smart Command Console</h3>
                    <p class="text-muted">
                        IntelliSense-powered command interface with autocomplete, player suggestions,
                        and real-time log viewing. 40+ Minecraft commands with parameter hints.
                    </p>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-info bg-gradient">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h3 class="h4 mb-3">Automated Backups & Restore</h3>
                    <p class="text-muted">
                        Schedule automatic world backups with configurable frequency and retention.
                        One-click world restore from any backup. Never lose progress again.
                    </p>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-warning bg-gradient">
                        <i class="bi bi-gear"></i>
                    </div>
                    <h3 class="h4 mb-3">Server Configuration</h3>
                    <p class="text-muted">
                        Edit server.properties directly from the web interface.
                        Organized by category for easy navigation. No SSH or FTP needed.
                    </p>
                </div>
            </div>

            <!-- Feature 7 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-danger bg-gradient">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="h4 mb-3">Player Tracking</h3>
                    <p class="text-muted">
                        See who's online in real-time with pulsing live indicators. Track player join/leave events.
                        Quick player management from the dashboard.
                    </p>
                </div>
            </div>

            <!-- Feature 8 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-secondary bg-gradient">
                        <i class="bi bi-phone"></i>
                    </div>
                    <h3 class="h4 mb-3">Multi-Platform</h3>
                    <p class="text-muted">
                        Access from desktop, mobile, or tablet. Native Android app available.
                        Manage your server from anywhere, anytime.
                    </p>
                </div>
            </div>

            <!-- Feature 9 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-primary bg-gradient">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h3 class="h4 mb-3">HTTPS Support</h3>
                    <p class="text-muted">
                        Full HTTPS and SSL/TLS certificate support for secure connections.
                        Protect your server management with encrypted communications.
                    </p>
                </div>
            </div>

            <!-- Feature 10 -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 p-4">
                    <div class="feature-icon bg-success bg-gradient">
                        <i class="bi bi-hdd-rack"></i>
                    </div>
                    <h3 class="h4 mb-3">Multi-Server Management</h3>
                    <p class="text-muted">
                        Manage multiple Minecraft servers from one dashboard.
                        Switch between servers, independent configs, centralized monitoring.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Technology Stack -->
<section class="tech-stack py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Built with Modern Technology</h2>
            <p class="lead text-muted">Leveraging the latest .NET technologies for maximum performance</p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-6 col-md-3 text-center">
                <div class="tech-badge p-4">
                    <i class="bi bi-microsoft display-4 text-primary"></i>
                    <p class="mt-2 fw-bold">.NET 10</p>
                    <small class="text-muted">Latest Framework</small>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="tech-badge p-4">
                    <i class="bi bi-window-desktop display-4 text-primary"></i>
                    <p class="mt-2 fw-bold">Blazor</p>
                    <small class="text-muted">Modern Web UI</small>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="tech-badge p-4 border border-warning">
                    <i class="bi bi-windows display-4 text-success"></i>
                    <p class="mt-2 fw-bold">Windows Service</p>
                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> Recommended</small>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="tech-badge p-4 opacity-50">
                    <i class="bi bi-box-seam display-4 text-muted"></i>
                    <p class="mt-2 fw-bold">Docker</p>
                    <small class="text-warning"><i class="bi bi-exclamation-triangle"></i> Deprecated v1.2</small>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="tech-badge p-4">
                    <i class="bi bi-phone display-4 text-primary"></i>
                    <p class="mt-2 fw-bold">.NET MAUI</p>
                    <small class="text-muted">Native Mobile</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Installation Section -->
<section class="deployment py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Easy Windows Installation</h2>
            <p class="lead text-muted">Get your server running in minutes</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-success shadow-lg">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-lightning-charge-fill display-1 text-success mb-3"></i>
                            <h3 class="h3 fw-bold">Windows Service Installer</h3>
                            <p class="text-muted">Professional installation with automatic configuration</p>
                        </div>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-4 text-center">
                                <div class="bg-light rounded p-3">
                                    <h4 class="h5 fw-bold text-success">5-10 min</h4>
                                    <p class="text-muted small mb-0">Setup Time</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-light rounded p-3">
                                    <h4 class="h5 fw-bold text-success">1-Click</h4>
                                    <p class="text-muted small mb-0">Installation</p>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-light rounded p-3">
                                    <h4 class="h5 fw-bold text-success">Auto-Start</h4>
                                    <p class="text-muted small mb-0">On Boot</p>
                                </div>
                            </div>
                        </div>

                        <ul class="list-unstyled mb-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Windows 10/11 & Server 2019+ support</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Automatic Windows Service setup</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Firewall configuration included</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Settings preserved during upgrades</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Web dashboard & mobile apps</li>
                        </ul>

                        <div class="text-center">
                            <a href="/get-started" class="btn btn-success btn-lg me-3">
                                <i class="bi bi-download me-2"></i>Get Started
                            </a>
                            <a href="/installer" class="btn btn-outline-success btn-lg">
                                <i class="bi bi-book me-2"></i>Installation Guide
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
