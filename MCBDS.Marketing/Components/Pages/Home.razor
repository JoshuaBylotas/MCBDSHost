    <div class="container text-center">
        <h2 class="display-4 fw-bold mb-4">Ready to Get Started?</h2>
        <p class="lead mb-4">
            Download MCBDS Manager today and take control of your Minecraft Bedrock Server
        </p>
        <div class="cta-buttons">
            <a href="/get-started" class="btn btn-light btn-lg">
                <i class="bi bi-download me-2"></i>Download Now
            </a>
        </div>
