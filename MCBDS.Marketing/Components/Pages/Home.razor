                        <a href="/contact" class="alert-link">Get Notified</a>
                    </div>
                </div>
            </div>

            <!-- Android Play Store App -->
            <div class="col-md-6">
                <div class="coming-soon-card h-100 p-5 border-2 border-success rounded">
                    <div class="text-center mb-4">
                        <i class="bi bi-android2 display-4 text-success mb-3 d-block"></i>
                        <h3 class="h4 mb-2">Android Play Store</h3>
                        <span class="badge bg-success">Q2 2025</span>
                    </div>
                    <p class="text-muted mb-4">
                        Full-featured Android app on Google Play Store for managing your Minecraft server on the go. 
                        Native UI optimized for mobile with push notifications and home screen widgets.
                    </p>
                    <ul class="list-unstyled mb-4">
