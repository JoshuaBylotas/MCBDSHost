                        <small class="text-muted">Manage multiple servers from one dashboard</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex">
                    <i class="bi bi-plug text-info me-3"></i>
                    <div>
                        <h5 class="h6">Plugin System</h5>
                        <small class="text-muted">Community plugins and extensions support</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex">
                    <i class="bi bi-discord text-info me-3"></i>
                    <div>
                        <h5 class="h6">Discord Integration</h5>
                        <small class="text-muted">Discord bot for server notifications and remote management</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <div class="text-center mt-5 pt-4 border-top">
            <h3 class="h5 fw-bold mb-3">Want to be notified about new releases?</h3>
            <a href="/contact" class="btn btn-primary btn-lg">
                <i class="bi bi-bell me-2"></i>Subscribe to Updates
            </a>
        </div>
    </div>
</section>

<!-- Technology Stack -->
