            </div>
        </div>

        <!-- Additional Coming Soon Features -->
        <div class="row mt-5 pt-4 border-top">
            <div class="col-12">
                <h3 class="h5 fw-bold mb-4">Other Planned Features</h3>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex">
                    <i class="bi bi-shield-check text-info me-3"></i>
                    <div>
                        <h5 class="h6">HTTPS Support</h5>
                        <small class="text-muted">Full HTTPS and SSL/TLS certificate support</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex">
                    <i class="bi bi-cloud-check text-info me-3"></i>
                    <div>
                        <h5 class="h6">Cloud Backups</h5>
                        <small class="text-muted">Automatic backup to AWS S3, Google Cloud Storage, or Azure Blob</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex">
                    <i class="bi bi-graph-up text-info me-3"></i>
